# Explicit publication locations: diagrams / aggregate summaries / synthetic data
# These are exceptions to file-extension rules, not to private data directories.
!/docs/assets/**/*.png
!/docs/assets/**/*.jpg
!/docs/assets/**/*.jpeg
!/docs/assets/**/*.webp
!/docs/assets/**/*.gif
!/docs/assets/**/*.pdf
!/docs/assets/**/*.csv
